---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoBranco from '../assets/img/marca/logo-branco.png';
import logoCor from '../assets/img/marca/logo-cor.png';
import { modalidades, categoriaNome, type Categoria } from '../data/modalidades';
import { whatsappLink } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const ativo = (href: string) => path === url(href) || (href !== '/' && path.startsWith(url(href)));
const grupos: Categoria[] = ['agua', 'academia', 'kids'];
const links = [
  { href: '/sobre/', label: 'Aquacenter' },
  { href: '/metodo/', label: 'Metodologia' },
  { href: '/horarios/', label: 'Horários' },
  { href: '/planos/', label: 'Planos' },
  { href: '/contato/', label: 'Contato' },
];
const modAtiva = modalidades.some((m) => path === url(`/${m.slug}/`));
---
<header class="hdr" data-header>
  <div class="hdr__in container">
    <a class="hdr__logo" href={url('/')} aria-label="Aquacenter Casa Verde — página inicial">
      <Image src={logoBranco} alt="" class="logo logo--light" width={176} height={120} loading="eager" />
      <Image src={logoCor} alt="" class="logo logo--color" width={176} height={120} loading="eager" />
    </a>

    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        <li><a href={url(links[0].href)} aria-current={ativo(links[0].href) ? 'page' : undefined}>{links[0].label}</a></li>
        <li class="has-mega">
          <button class="mega-btn" aria-expanded="false" aria-controls="mega" aria-current={modAtiva ? 'page' : undefined}>
            Modalidades <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <div class="mega" id="mega">
            <div class="mega__in">
              {grupos.map((g) => (
                <div class="mega__col">
                  <p class="mega__title">{categoriaNome[g]}</p>
                  <ul>
                    {modalidades.filter((m) => m.categorias.includes(g)).map((m) => (
                      <li><a href={url(`/${m.slug}/`)}>{m.nome}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </li>
        {links.slice(1).map((l) => (
          <li><a href={url(l.href)} aria-current={ativo(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--accent btn--sm hdr__cta" href={whatsappLink()} target="_blank" rel="noopener" data-track="whatsapp">
      <Icon name="whatsapp" /> <span>Aula grátis</span>
    </a>
    <button class="hdr__burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-mobile" data-menu-open>
      <Icon name="menu" />
    </button>
  </div>
</header>

<div class="mmenu" id="menu-mobile" hidden data-menu>
  <div class="mmenu__top container">
    <span class="mmenu__brand">Aquacenter</span>
    <button class="mmenu__close" aria-label="Fechar menu" data-menu-close><Icon name="close" /></button>
  </div>
  <nav class="mmenu__nav container" aria-label="Menu">
    <a href={url('/')}>Início</a>
    {links.map((l) => <a href={url(l.href)}>{l.label}</a>)}
    <p class="mmenu__label">Modalidades</p>
    <div class="mmenu__mods">
      {modalidades.map((m) => <a href={url(`/${m.slug}/`)}>{m.nome}</a>)}
    </div>
  </nav>
  <div class="mmenu__foot container">
    <a class="btn btn--accent" href={whatsappLink()} target="_blank" rel="noopener" data-track="whatsapp"><Icon name="whatsapp" /> Agende sua aula grátis</a>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: #fff;
    transition:
      background 0.4s,
      color 0.4s,
      transform 0.5s var(--ease-out),
      box-shadow 0.4s;
  }
  .hdr.is-solid {
    color: var(--c-ink);
    background: rgb(243 251 254 / 82%);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    box-shadow: 0 1px 0 rgb(6 42 79 / 8%);
  }
  .hdr.is-hidden {
    transform: translateY(-100%);
  }
  .hdr__in {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .hdr__logo {
    position: relative;
    flex: none;
    width: 98px;
    height: 66px;
  }
  .logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.4s;
  }
  .logo--color,
  .is-solid .logo--light {
    opacity: 0;
  }
  .is-solid .logo--color {
    opacity: 1;
  }
  .hdr__nav {
    margin-left: auto;
  }
  .hdr__nav > ul {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }
  .hdr__nav a,
  .mega-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border: 0;
    background: none;
    color: inherit;
    font: 600 15px/1 var(--f-body);
    text-decoration: none;
    border-radius: 999px;
    cursor: pointer;
    position: relative;
  }
  .hdr__nav > ul > li > a::after,
  .mega-btn::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }
  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current]::after,
  .mega-btn:hover::after,
  .mega-btn[aria-current]::after {
    transform: scaleX(1);
  }
  .has-mega {
    position: relative;
  }
  .mega {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: max-content;
    max-width: 90vw;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out),
      visibility 0.3s;
  }
  .mega::before {
    content: '';
    position: absolute;
    inset: -14px 0 auto;
    height: 14px;
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega,
  .has-mega.is-open .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .mega__in {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 40px;
    padding: 26px 28px;
    border-radius: var(--r-md);
    background: #fff;
    color: var(--c-ink);
    box-shadow: var(--shadow-2);
  }
  .mega__title {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-brand);
  }
  .mega ul {
    list-style: none;
  }
  .mega a {
    display: block;
    padding: 7px 0;
    font-size: 15px;
    font-weight: 600;
    border-radius: 0;
  }
  .mega a:hover {
    color: var(--c-brand);
  }
  .hdr__burger {
    display: none;
    margin-left: auto;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 14%);
    color: inherit;
    cursor: pointer;
    place-items: center;
  }
  .is-solid .hdr__burger {
    background: var(--c-mist);
  }
  .hdr__burger :global(svg) {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 1100px) {
    .hdr__nav {
      display: none;
    }
    .hdr__burger {
      display: grid;
    }
    .hdr__cta {
      margin-left: auto;
    }
    .hdr__burger {
      margin-left: 0;
    }
  }
  @media (max-width: 480px) {
    .hdr__cta span {
      display: none;
    }
    .hdr__cta {
      width: 46px;
      min-height: 46px;
      padding: 0;
    }
  }

  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: radial-gradient(120% 80% at 100% 0%, var(--c-brand), var(--c-deep) 55%, var(--c-abyss));
    color: #fff;
    clip-path: circle(0% at calc(100% - 44px) 38px);
    transition: clip-path 0.7s var(--ease-out);
    overflow-y: auto;
  }
  .mmenu[hidden] {
    display: none;
  }
  .mmenu.is-open {
    clip-path: circle(150% at calc(100% - 44px) 38px);
  }
  .mmenu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-h);
  }
  .mmenu__brand {
    font: 700 22px var(--f-display);
  }
  .mmenu__close {
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 14%);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .mmenu__close :global(svg) {
    width: 24px;
  }
  .mmenu__nav {
    display: flex;
    flex-direction: column;
    padding-block: 12px 24px;
  }
  .mmenu__nav > a {
    padding: 8px 0;
    font: 700 clamp(28px, 8vw, 40px) / 1.1 var(--f-display);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .mmenu__label {
    margin-top: 24px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sky);
  }
  .mmenu__mods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px 16px;
    margin-top: 8px;
  }
  .mmenu__mods a {
    padding: 8px 0;
    font-weight: 600;
    text-decoration: none;
    color: rgb(255 255 255 / 85%);
  }
  .mmenu__foot {
    margin-top: auto;
    padding-block: 16px max(24px, env(safe-area-inset-bottom));
  }
  .mmenu__foot .btn {
    width: 100%;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const megaBtn = document.querySelector<HTMLButtonElement>('.mega-btn');

  let lastY = scrollY;
  const onScroll = () => {
    const y = scrollY;
    const threshold = document.body.dataset.solidAfter ? Number(document.body.dataset.solidAfter) : innerHeight * 0.6;
    header.classList.toggle('is-solid', y > threshold);
    header.classList.toggle('is-hidden', y > lastY && y > innerHeight && !menu.classList.contains('is-open'));
    lastY = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  megaBtn?.addEventListener('click', () => {
    const li = megaBtn.parentElement!;
    const open = !li.classList.contains('is-open');
    li.classList.toggle('is-open', open);
    megaBtn.setAttribute('aria-expanded', String(open));
  });

  const setMenu = (open: boolean) => {
    if (open) menu.hidden = false;
    requestAnimationFrame(() => menu.classList.toggle('is-open', open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn.focus();
    else {
      setTimeout(() => (menu.hidden = !menu.classList.contains('is-open') ? true : menu.hidden), 700);
      openBtn.focus();
    }
  };
  openBtn.addEventListener('click', () => setMenu(true));
  closeBtn.addEventListener('click', () => setMenu(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && menu.classList.contains('is-open') && setMenu(false));
</script>
