---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
---
<section class="hero" data-hero data-depth-label="Mergulho" aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__fallback" aria-hidden="true"></div>
    <canvas class="hero__canvas" data-water aria-hidden="true"></canvas>
    <div class="hero__shade" aria-hidden="true" data-hero-shade></div>

    <div class="hero__content container" data-hero-content>
      <p class="eyebrow light" data-hero-in style="--d: 0s">Desde {site.desde} · Casa Verde · SP</p>
      <h1 id="hero-title" class="hero__title" data-split data-split-manual data-hero-title>
        Uma academia para toda a <em class="accent-word">família.</em>
      </h1>
      <p class="hero__sub" data-hero-in style="--d: 0.35s">
        Natação para bebês, crianças e adultos, hidroginástica, musculação e aulas de ginástica. Piscinas aquecidas o ano inteiro.
      </p>
      <div class="hero__ctas" data-hero-in style="--d: 0.5s">
        <a class="btn btn--accent" href={whatsappLink()} target="_blank" rel="noopener" data-track="whatsapp">
          <Icon name="whatsapp" /> Agende sua aula experimental grátis
        </a>
        <a class="btn btn--ghost" href="#modalidades">Ver modalidades</a>
      </div>
      <ul class="hero__chips" data-hero-in style="--d: 0.65s">
        <li><Icon name="thermo" /> Piscinas aquecidas</li>
        <li><Icon name="medal" /> Metodologia Aquativa</li>
        <li><Icon name="car" /> Estacionamento com manobrista</li>
      </ul>
    </div>

    <p class="hero__hint" data-hero-hint aria-hidden="true">
      <span class="hero__hint-dot"></span>
      <span class="hint-fine">Passe o mouse na água · clique para respingar</span>
      <span class="hint-touch">Toque na água</span>
    </p>
    <a class="hero__scroll" href="#numeros" data-hero-scroll>
      <span>Role para mergulhar</span>
      <span class="hero__scroll-line"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 240svh;
    background: var(--c-deep);
  }
  .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    color: #fff;
    cursor: crosshair;
  }
  .hero__fallback,
  .hero__canvas,
  .hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Piscina em CSS: aparece antes do WebGL carregar e em aparelhos sem WebGL. */
  .hero__fallback {
    background:
      radial-gradient(60% 50% at 70% 45%, rgb(255 255 255 / 22%), transparent 70%),
      linear-gradient(rgb(255 255 255 / 45%) 2px, transparent 2px) 0 0 / 4.4vh 4.4vh,
      linear-gradient(90deg, rgb(255 255 255 / 45%) 2px, transparent 2px) 0 0 / 4.4vh 4.4vh,
      linear-gradient(transparent 22%, #0a4a7d 22% 30%, transparent 30% 72%, #0a4a7d 72% 80%, transparent 80%),
      #28a9cb;
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 0.8s;
  }
  .hero__canvas[data-live] {
    opacity: 1;
  }
  .hero__shade {
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(4 26 51 / 62%) 0%, rgb(4 26 51 / 30%) 42%, transparent 68%),
      linear-gradient(0deg, rgb(4 26 51 / 55%) 0%, transparent 45%),
      linear-gradient(180deg, rgb(4 26 51 / 35%) 0%, transparent 18%);
  }
  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: clamp(56px, 10vh, 110px);
    pointer-events: none;
  }
  .hero__content > * {
    pointer-events: auto;
    max-width: 760px;
  }
  .hero__title {
    margin-top: 18px;
    font-size: clamp(46px, 7.4vw, 118px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-shadow: 0 4px 40px rgb(4 26 51 / 35%);
    max-width: 11ch;
  }
  .hero__title em {
    color: var(--c-sky);
  }
  .hero__sub {
    margin-top: 22px;
    max-width: 52ch;
    font-size: clamp(17px, 1.1vw + 11px, 21px);
    line-height: 1.5;
    color: rgb(255 255 255 / 88%);
    text-shadow: 0 2px 20px rgb(4 26 51 / 40%);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .hero__ctas .btn {
    color: #fff;
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 28px;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
    color: rgb(255 255 255 / 85%);
  }
  .hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .hero__chips :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--c-sky);
  }

  .hero__hint {
    position: absolute;
    z-index: 2;
    top: calc(var(--header-h) + 22px);
    right: var(--gutter);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(4 26 51 / 28%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 13px;
    font-weight: 600;
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .hero__hint.is-done {
    opacity: 0;
  }
  .hero__hint-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
  }
  .hero__hint-dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border: 2px solid #fff;
    border-radius: 50%;
    animation: hint 1.8s var(--ease-out) infinite;
  }
  @keyframes hint {
    from {
      transform: scale(0.4);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  .hint-touch {
    display: none;
  }
  @media (pointer: coarse) {
    .hint-fine {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  .hero__scroll {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: clamp(40px, 8vh, 90px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    position: relative;
    width: 2px;
    height: 70px;
    background: rgb(255 255 255 / 30%);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    animation: scrollcue 2s var(--ease-out) infinite;
  }
  @keyframes scrollcue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  /* Antes do respingo o conteúdo fica submerso. */
  .js .hero:not(.is-in) [data-hero-in] {
    opacity: 0;
    transform: translateY(24px);
  }
  .hero.is-in [data-hero-in] {
    transition:
      opacity 1s var(--ease-out) var(--d, 0s),
      transform 1.2s var(--ease-out) var(--d, 0s);
  }

  @media (max-width: 760px) {
    .hero {
      height: 210svh;
    }
    .hero__shade {
      background:
        linear-gradient(0deg, rgb(4 26 51 / 78%) 0%, rgb(4 26 51 / 45%) 45%, transparent 75%),
        linear-gradient(180deg, rgb(4 26 51 / 40%) 0%, transparent 20%);
    }
    .hero__content {
      padding-bottom: 36px;
    }
    .hero__title {
      font-size: clamp(42px, 12.5vw, 64px);
    }
    .hero__ctas .btn {
      width: 100%;
    }
    .hero__chips {
      display: none;
    }
    .hero__scroll {
      display: none;
    }
    .hero__hint {
      left: 50%;
      right: auto;
      translate: -50% 0;
    }
  }
</style>

<script>
  import { createWater } from '../scripts/water/engine';
  import { gsap, ScrollTrigger, reduced } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-water]')!;
  const title = hero.querySelector<HTMLElement>('[data-hero-title]')!;
  const hint = hero.querySelector<HTMLElement>('[data-hero-hint]')!;
  const content = hero.querySelector<HTMLElement>('[data-hero-content]')!;
  const scrollCue = hero.querySelector<HTMLElement>('[data-hero-scroll]')!;
  const shade = hero.querySelector<HTMLElement>('[data-hero-shade]')!;

  let revealed = false;
  const words = () => title.querySelectorAll<HTMLElement>('.w > span');
  function reveal() {
    if (revealed) return;
    revealed = true;
    hero.classList.add('is-in');
    if (reduced) return void gsap.set(words(), { yPercent: 0, y: 0 });
    gsap.fromTo(
      words(),
      { yPercent: 110, y: 0, filter: 'blur(8px)' },
      { yPercent: 0, filter: 'blur(0px)', duration: 1.3, ease: 'expo.out', stagger: 0.07, clearProps: 'filter' },
    );
  }

  const water = reduced
    ? null
    : createWater(canvas, {
        mode: 'pool',
        intro: true,
        idleDrops: true,
        onSplash: reveal,
        onReady: () => canvas.setAttribute('data-live', ''),
      });

  if (water) {
    setTimeout(reveal, 2600); // garantia, caso o aparelho seja lento
  } else {
    reveal();
  }

  // Dica de interação some depois do primeiro toque ou em alguns segundos.
  const hideHint = () => hint.classList.add('is-done');
  hero.addEventListener('pointerdown', hideHint, { once: true });
  setTimeout(hideHint, 7000);

  // Mergulho: a rolagem leva a câmera para baixo d'água.
  if (!reduced) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.6,
        onUpdate: (st) => {
          const d = gsap.utils.clamp(0, 1, (st.progress - 0.18) / 0.62);
          water?.setDive(d);
          if (d > 0) hideHint();
        },
      },
    });
    tl.to(content, { y: -120, opacity: 0, filter: 'blur(6px)', ease: 'power2.in', duration: 0.3 }, 0)
      .to(scrollCue, { opacity: 0, duration: 0.08 }, 0)
      .to(shade, { opacity: 0, duration: 0.4 }, 0.15)
      .to({}, { duration: 0.7 });
  }

  addEventListener('load', () => ScrollTrigger.refresh());
</script>
